// REFERÊNCIA — compare com as regras publicadas no Firebase Console (Firestore → Regras).
// Este arquivo não é publicado automaticamente.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Um documento por usuário, com o mesmo id do login. Cada pessoa só enxerga e altera o próprio.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Criação (é o que o site faz no cadastro): campos fixos e começando do zero.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'xp', 'streak', 'licoesCompletas', 'criadoEm'])
        && request.resource.data.xp == 0
        && request.resource.data.streak == 0
        && request.resource.data.licoesCompletas.size() == 0;

      // Atualização: o dono não pode trocar a data de criação.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.criadoEm == resource.data.criadoEm;

      allow delete: if false;
    }

    // Lista de e-mails da newsletter: qualquer visitante pode se inscrever, ninguém pode ler pelo navegador.
    // (Leia a lista pelo Console do Firebase.)
    match /newsletter/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'origem', 'criadoEm'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.origem is string
        && request.resource.data.origem.size() <= 40;
      allow read, update, delete: if false;
    }
  }
}
