        {
          "tipo": "gramatica",
          "min": 14,
          "titulo": "Combinações de letras que mudam o som",
          "explicacao": "Algumas letras juntas formam um som próprio. A regra vale sempre. Uma vogal seguida de uma consoante simples costuma ser longa (Tal, Name); seguida de duas consoantes iguais, costuma ser curta (Ball, Kette). O «ch» tem dois sons: suave («ç») depois de e, i, ä, ö, ü, l, n, r; áspero («rr» carioca) depois de a, o, u e au. As combinações «sp» e «st» no início de uma palavra soam «xp» e «xt».",
          "comparacao": "em português «ei» e «ie» não existem como sons próprios, e o «ch» soa como «x». No alemão, «ei» é «ai», «ie» é um «i» longo, «sch» é «x» e «ch» é «ç» ou «rr».",
          "tabela": [
            {
              "combinacao": "ei",
              "som": "«ai»",
              "exemplo": "Eis (ais), Wein (vain)"
            },
            {
              "combinacao": "ie",
              "som": "«i» longo",
              "exemplo": "Bier (bir), Brief (brif)"
            },
            {
              "combinacao": "eu, äu",
              "som": "«ói»",
              "exemplo": "Euro (ói-ro), Häuser (hóizer)"
            },
            {
              "combinacao": "au",
              "som": "«au»",
              "exemplo": "Haus (haus), Auto (áuto)"
            },
            {
              "combinacao": "sch",
              "som": "«x» de «xícara»",
              "exemplo": "Schule (xúle), Fisch (fix)"
            },
            {
              "combinacao": "sp, st (início)",
              "som": "«xp», «xt»",
              "exemplo": "Sport (xport), Stein (xtain)"
            },
            {
              "combinacao": "ch (suave)",
              "som": "«ç»",
              "exemplo": "ich (iç), Milch (milç)"
            },
            {
              "combinacao": "ch (áspero)",
              "som": "«rr» carioca",
              "exemplo": "Buch (burr), acht (arrt)"
            },
            {
              "combinacao": "tsch",
              "som": "«tch»",
              "exemplo": "Deutsch (dóitx)"
            },
            {
              "combinacao": "pf",
              "som": "«p» e «f» juntos",
              "exemplo": "Apfel (ápfel)"
            },
