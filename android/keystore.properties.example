# Copie para android/keystore.properties (esse arquivo real fica fora do Git).
# A upload keystore é gerada por você, na sua máquina; nunca a envie a ninguém nem a comite.
# Caminho relativo à pasta android/ ou absoluto.
storeFile=/caminho/seguro/linvuu-upload.jks
storePassword=SUA_SENHA_DO_KEYSTORE
keyAlias=linvuu-upload
keyPassword=SUA_SENHA_DA_CHAVE
