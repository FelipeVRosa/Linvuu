            },
            {
              "caso": "Acusativo",
              "pergunta": "Кого? Что?",
              "funcao": "o que recebe a ação (objeto direto)",
              "exemplo": "Я читаю книгу."
            },
            {
              "caso": "Genitivo",
              "pergunta": "Кого? Чего?",
