          "tipo": "gramatica",
          "min": 12,
          "titulo": "aus, bei, mit, nach, seit, von, zu: sempre dativo",
          "explicacao": "Sete preposições pedem SEMPRE o dativo (decore-as em fila: aus, bei, mit, nach, seit, von, zu; «gegenüber» também). Usos: «aus» = de (origem, material): aus Brasilien. «Bei» = na casa de, no local de: bei Anna, beim Arzt. «Mit» = com, e meio de transporte: mit dem Bus. «Nach» = depois de; para cidades e países: nach dem Essen, nach Berlin. «Seit» = desde: seit zwei Jahren. «Von» = de, por: vom Chef. «Zu» = para, até (pessoas e lugares): zum Arzt, zur Schule. Contrações: bei dem = beim, von dem = vom, zu dem = zum, zu der = zur.",
          "tabela": [
            {
              "preposicao": "aus",
              "significado": "de (origem, material)",
              "exemplo": "Ich komme aus dem Haus."
            },
            {
              "preposicao": "bei",
              "significado": "na casa de, no local de",
              "exemplo": "Ich bin beim Arzt. Ich wohne bei meiner Oma."
            },
            {
              "preposicao": "mit",
              "significado": "com; meio de transporte",
              "exemplo": "Ich fahre mit dem Zug."
            },
            {
              "preposicao": "nach",
              "significado": "depois de; para cidades e países",
              "exemplo": "Nach der Arbeit fahre ich nach Berlin."
            },
            {
              "preposicao": "seit",
              "significado": "desde, há (tempo)",
              "exemplo": "Ich wohne seit zwei Jahren hier."
            },
            {
              "preposicao": "von",
              "significado": "de, por",
              "exemplo": "Das Geschenk ist von meinem Chef."
            },
            {
              "preposicao": "zu",
              "significado": "para, até (pessoas, lugares)",
              "exemplo": "Ich gehe zum Arzt."
            }
          ],
          "erros": [
            {
              "errado": "Ich fahre mit der Bus.",
              "certo": "Ich fahre mit dem Bus.",
              "motivo": "«mit» pede dativo; «Bus» é masculino: dem."
