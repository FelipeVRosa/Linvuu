              "exemplo": "Quelle (kvéle)"
            },
            {
              "combinacao": "ck",
              "som": "«k» curto",
              "exemplo": "Jacke (iáke)"
            },
            {
              "combinacao": "ng",
              "som": "nasal, sem «g» solto",
              "exemplo": "singen (zíngen)"
            }
          ],
