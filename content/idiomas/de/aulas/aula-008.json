        {
          "tipo": "gramatica",
          "min": 12,
          "titulo": "Verbos separáveis: o prefixo vai para o fim",
          "explicacao": "Muitos verbos alemães têm um prefixo que se separa: «aufstehen» (levantar-se). No presente, o verbo conjugado fica na 2ª posição e o PREFIXO vai para o FIM da frase: «Ich stehe um sieben Uhr auf.» No infinitivo, ou com um verbo modal, o verbo fica inteiro: «Ich möchte um sieben Uhr aufstehen.» Prefixos separáveis comuns: auf-, an-, ein-, mit-, ab-, fern-, aus-, zurück-. Outros prefixos NÃO se separam: be-, ge-, er-, ver-, zer-, ent-, emp-: «Ich besuche meine Oma» (besuchen).",
          "comparacao": "em português o verbo não se parte. Em alemão o prefixo vai para o fim da frase e a frase fica «emoldurada» entre o verbo e o prefixo.",
          "tabela": [
            {
              "infinitivo": "aufstehen",
              "exemplo": "Ich stehe um sieben Uhr auf.",
              "pt": "Eu me levanto às sete."
            },
            {
              "infinitivo": "anrufen",
              "exemplo": "Er ruft seine Mutter an.",
              "pt": "Ele liga para a mãe."
            },
            {
              "infinitivo": "einkaufen",
              "exemplo": "Wir kaufen heute ein.",
              "pt": "Hoje fazemos compras."
            },
            {
              "infinitivo": "fernsehen",
              "exemplo": "Sie sieht abends fern.",
              "pt": "Ela vê TV à noite."
            },
            {
              "infinitivo": "ankommen",
              "exemplo": "Der Zug kommt um acht Uhr an.",
              "pt": "O trem chega às oito."
            },
            {
              "infinitivo": "mitkommen",
              "exemplo": "Kommst du mit?",
              "pt": "Você vem junto?"
            },
            {
              "infinitivo": "besuchen (inseparável)",
              "exemplo": "Ich besuche meine Oma.",
              "pt": "Visito minha avó."
            }
          ],
          "erros": [
            {
              "errado": "Ich aufstehe um sieben Uhr.",
              "certo": "Ich stehe um sieben Uhr auf.",
              "motivo": "O prefixo separável vai para o fim da frase."
            }
          ],
          "tag": "Verbos"
        },
