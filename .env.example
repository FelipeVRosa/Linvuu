# Login e perfis (Firebase) — ver docs/AUTENTICACAO.md. Valores em Firebase Console → Configurações do projeto → Seus apps.
# São chaves públicas (ficam no navegador); em produção, defina-as nas variáveis de ambiente do Render ANTES do build.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
# "true" só depois de ativar o provedor Google no Firebase
VITE_AUTH_GOOGLE="false"
# Só para testes locais com emuladores (ignorados em produção)
# VITE_AUTH_EMULATOR="127.0.0.1:9099"
# VITE_FIRESTORE_EMULATOR="127.0.0.1:8080"
