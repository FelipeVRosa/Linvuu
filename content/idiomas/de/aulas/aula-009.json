        {
          "tipo": "gramatica",
          "min": 10,
          "titulo": "Wo? e Wohin?: «em» e «para»",
          "explicacao": "Com «in», o alemão distingue ONDE você está (Wo?) de PARA ONDE você vai (Wohin?). Wo? usa o DATIVO: masculino e neutro «im» (in dem), feminino «in der». Wohin? usa o ACUSATIVO: masculino «in den», feminino «in die», neutro «ins» (in das). Para ir até um lugar existe também «zu» (sempre dativo): zum (zu dem) Bahnhof, zur (zu der) Post; e «nach» para cidades e países: nach Berlin. Os casos completos vêm nas aulas 11 a 13; por enquanto, memorize o quadro.",
          "comparacao": "em português a preposição muda («no parque», «ao parque»). Em alemão a preposição é a mesma («in»), e quem muda é o artigo.",
          "tabela": [
            {
              "genero": "masculino",
              "wo": "im Park",
              "wohin": "in den Park",
              "zu": "zum Park"
            },
            {
              "genero": "feminino",
              "wo": "in der Schule",
              "wohin": "in die Schule",
              "zu": "zur Schule"
            },
            {
              "genero": "neutro",
              "wo": "im Kino",
              "wohin": "ins Kino",
              "zu": "zum Kino"
            }
          ],
          "erros": [
            {
              "errado": "Ich gehe im Kino.",
              "certo": "Ich gehe ins Kino.",
              "motivo": "Com movimento (Wohin?): acusativo, «ins»."
            },
            {
              "errado": "Ich bin in den Park.",
              "certo": "Ich bin im Park.",
              "motivo": "Parado (Wo?): dativo, «im»."
            }
