          "tipo": "gramatica",
          "min": 10,
          "titulo": "A ordem da frase e as primeiras perguntas",
          "explicacao": "O verbo conjugado fica sempre na SEGUNDA posição da frase afirmativa e das perguntas com palavra interrogativa: «Ich heiße Anna.», «Wie heißt du?», «Woher kommst du?». A pergunta de sim ou não começa pelo verbo: «Heißt du Anna?». Os pronomes pessoais são: ich, du, er, sie, es, wir, ihr, sie e Sie (formal).",
          "comparacao": "em português o verbo também vem logo depois do sujeito, mas o alemão fixa o verbo na segunda posição mesmo quando outro termo abre a frase.",
          "tabela": [
            {
              "pergunta": "Wie heißt du?",
              "resposta": "Ich heiße Anna.",
              "pt": "Como você se chama? Eu me chamo Anna."
            },
            {
              "pergunta": "Wie heißen Sie?",
              "resposta": "Ich heiße Müller.",
              "pt": "Como o senhor se chama? Eu me chamo Müller."
            },
            {
              "pergunta": "Woher kommst du?",
              "resposta": "Ich komme aus Brasilien.",
              "pt": "De onde você vem? Venho do Brasil."
            },
            {
              "pergunta": "Wer ist das?",
              "resposta": "Das ist Ben.",
              "pt": "Quem é este? É o Ben."
            }
          ],
          "erros": [
            {
              "errado": "Ich Anna heiße.",
              "certo": "Ich heiße Anna.",
              "motivo": "O verbo conjugado fica na segunda posição."
            }
