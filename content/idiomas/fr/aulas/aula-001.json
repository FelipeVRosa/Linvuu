            },
            {
              "padrao": "consoante final",
              "som": "quase sempre muda",
              "exemplos": "petit, grand, vous, trop"
            },
            {
              "padrao": "c, r, f, l finais",
              "som": "costumam soar",
              "exemplos": "sac, bonjour, chef, animal"
            },
            {
              "padrao": "liaison",
              "som": "«s» soa como «z»",
              "exemplos": "les amis, vous avez, ils ont"
