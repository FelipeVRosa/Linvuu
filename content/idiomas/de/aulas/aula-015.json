        {
          "tipo": "gramatica",
          "min": 12,
          "titulo": "Perfekt: haben + Partizip II",
          "explicacao": "O Perfekt é o passado da fala do dia a dia. Forma-se com o auxiliar «haben» (ou «sein») no presente, na 2ª posição, e o PARTIZIP II no FIM da frase: «Ich habe Deutsch gelernt». O Partizip II regular é ge- + raiz + -t: machen → gemacht, wohnen → gewohnt; raiz em -t/-d: arbeiten → gearbeitet. Sem «ge-» nos verbos em -ieren (studieren → studiert) e com prefixos inseparáveis (be-, ver-, er-, ent-, zer-, emp-: besuchen → besucht). Nos separáveis, «ge» fica NO MEIO: einkaufen → eingekauft, aufstehen → aufgestanden.",
          "comparacao": "o pretérito perfeito português também usa um auxiliar («eu tenho falado»), mas o alemão usa o Perfekt para o passado comum («eu fiz»). O particípio vai para o fim.",
          "tabela": [
            {
              "infinitivo": "machen",
              "participio": "gemacht",
              "exemplo": "Ich habe Hausaufgaben gemacht."
            },
            {
              "infinitivo": "lernen",
              "participio": "gelernt",
              "exemplo": "Wir haben Deutsch gelernt."
            },
            {
              "infinitivo": "arbeiten",
              "participio": "gearbeitet",
              "exemplo": "Er hat gestern gearbeitet."
            },
            {
              "infinitivo": "studieren",
              "participio": "studiert",
              "exemplo": "Sie hat in Berlin studiert."
            },
            {
              "infinitivo": "besuchen",
              "participio": "besucht",
              "exemplo": "Ich habe meine Oma besucht."
            },
            {
              "infinitivo": "einkaufen (separável)",
              "participio": "eingekauft",
              "exemplo": "Wir haben heute eingekauft."
            }
          ],
          "erros": [
            {
              "errado": "Ich habe gearbeit.",
              "certo": "Ich habe gearbeitet.",
              "motivo": "Raiz em -t: o particípio leva -et."
            },
            {
              "errado": "Ich habe geStudiert.",
              "certo": "Ich habe studiert.",
              "motivo": "Verbos em -ieren não levam «ge-»."
            }
          ],
          "tag": "Verbos"
